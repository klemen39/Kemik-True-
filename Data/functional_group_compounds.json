  "detection_rules": {
    "order": [
      "carboxylic_acid_group",
      "ester_group",
      "amide_group",
      "aldehyde_group",
      "ketone_group",
      "nitrile_group",
      "alcohol_group",
      "ether_group",
      "amine_groups",
      "thiol_group",
      "haloalkane_group",
      "alkene_group",
      "alkyne_group"
    ],
    "rules": [
      {
        "id": "detect_carboxylic_acid",
        "required_subgraph": {
          "central_atom": "C",
          "double_bonded_to": "O",
          "single_bonded_to": "O",
          "second_oxygen_bonded_to": "H"
        },
        "result": "carboxylic_acid_group"
      },
      {
        "id": "detect_ester",
        "required_subgraph": {
          "central_atom": "C",
          "double_bonded_to": "O",
          "single_bonded_to": "O",
          "second_oxygen_bonded_to": "C"
        },
        "result": "ester_group"
      },
      {
        "id": "detect_amide",
        "required_subgraph": {
          "central_atom": "C",
          "double_bonded_to": "O",
          "single_bonded_to": "N"
        },
        "result": "amide_group"
      },
      {
        "id": "detect_aldehyde",
        "required_subgraph": {
          "central_atom": "C",
          "double_bonded_to": "O",
          "single_bonded_to": "H"
        },
        "result": "aldehyde_group"
      },
      {
        "id": "detect_ketone",
        "required_subgraph": {
          "central_atom": "C",
          "double_bonded_to": "O",
          "single_bonded_carbon_neighbors": 2
        },
        "result": "ketone_group"
      },
      {
        "id": "detect_alcohol",
        "required_subgraph": {
          "oxygen_single_bonded_to": [
            "C",
            "H"
          ]
        },
        "exclude_if_adjacent_to_carbonyl": true,
        "result": "alcohol_group"
      },
      {
        "id": "detect_ether",
        "required_subgraph": {
          "oxygen_single_bonded_to_two_carbons": true
        },
        "exclude_if_adjacent_to_carbonyl": true,
        "result": "ether_group"
      },
      {
        "id": "detect_nitrile",
        "required_subgraph": {
          "bond": "C#N"
        },
        "result": "nitrile_group"
      },
      {
        "id": "detect_alkene",
        "required_subgraph": {
          "bond": "C=C"
        },
        "result": "alkene_group"
      },
      {
        "id": "detect_alkyne",
        "required_subgraph": {
          "bond": "C#C"
        },
        "result": "alkyne_group"
      }
    ]
  },
  "renderer_rules": {
    "functional_groups": {
      "use_reusable_group_templates": true,
      "preserve_group_connectivity": true,
      "render_all_nonbonding_electrons": true,
      "render_formal_charges": true,
      "render_multiple_bonds": true,
      "expand_condensed_groups": true,
      "allow_multiple_functional_groups": true
    },
    "carbon_skeleton": {
      "generate_implicit_hydrogens": true,
      "carbon_target_valence": 4,
      "default_bond_order": 1,
      "layout_linear_chains_as_zigzag": true,
      "layout_double_bonds_as_planar": true,
      "layout_triple_bonds_as_linear": true
    },
    "heteroatoms": {
      "oxygen_default_valence": 2,
      "oxygen_default_lone_pairs": 2,
      "nitrogen_default_valence": 3,
      "nitrogen_default_lone_pairs": 1,
      "sulfur_default_valence": 2,
      "sulfur_default_lone_pairs": 2,
      "halogen_default_valence": 1,
      "halogen_default_lone_pairs": 3
    },
    "layout": {
      "minimum_atom_spacing": 1.5,
      "functional_group_spacing": 2,
      "center_structure": true,
      "rotate_to_best_fit": true,
      "avoid_overlapping_lone_pairs": true,
      "prefer_longest_carbon_chain_horizontal": true
    }
  },
  "validation_rules": {
    "validate_atom_valence": true,
    "validate_total_valence_electrons": true,
    "validate_formal_charges": true,
    "require_complete_bond_graph": true,
    "carbon_default_valence": 4,
    "hydrogen_default_valence": 1,
    "oxygen_default_valence": 2,
    "nitrogen_default_valence": 3,
    "halogen_default_valence": 1,
    "allow_resonance": true,
    "allow_charged_functional_groups": true,
    "allow_multiple_functional_groups_per_compound": true
  }
