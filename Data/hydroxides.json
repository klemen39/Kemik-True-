  "generic_rule": {
    "id": "hydroxide_compound_rule",
    "group_name": "hydroxide",
    "anion_template": "OH^-",
    "anion_formula": "OH",
    "anion_charge": -1,
    "compound_type": "ionic",
    "charge_balance": {
      "method": "absolute_cation_charge",
      "cation_count": 1,
      "hydroxide_count": "abs(cation_charge)"
    },
    "formula_formatting": {
      "use_parentheses_when_hydroxide_count_above_one": true,
      "omit_subscript_one": true,
      "examples": [
        {
          "cation": "Na",
          "cation_charge": 1,
          "cation_count": 1,
          "hydroxide_count": 1,
          "result": "NaOH"
        },
        {
          "cation": "Ca",
          "cation_charge": 2,
          "cation_count": 1,
          "hydroxide_count": 2,
          "result": "Ca(OH)2"
        },
        {
          "cation": "Al",
          "cation_charge": 3,
          "cation_count": 1,
          "hydroxide_count": 3,
          "result": "Al(OH)3"
        }
      ]
    }
  },
  "renderer_rules": {
    "polyatomic_ion": {
      "render_atoms_inside_brackets": true,
      "render_overall_charge_outside_brackets": true,
      "charge_position": "top_right",
      "render_formal_charges": true,
      "render_lone_pairs": true
    },
    "ionic_compound": {
      "draw_bonds_between_ions": false,
      "render_each_ion_separately": true,
      "repeat_ions_using_coefficient": true,
      "preserve_polyatomic_group_structure": true,
      "show_cation_charge": true,
      "show_anion_charge": true
    },
    "layout": {
      "maximum_ions_per_row": 4,
      "wrap_large_ionic_compounds": true,
      "center_polyatomic_groups": true,
      "hydroxide_orientation": "horizontal"
    }
  }
