  "generic_rules": {
    "binary_ionic_compound_rule": {
      "id": "binary_ionic_compound",
      "description": "Create a neutral ionic formula using one cation and one anion.",
      "compound_type": "ionic",
      "charge_balance": {
        "method": "least_common_multiple",
        "cation_count": "lcm(abs(cation_charge), abs(anion_charge)) / abs(cation_charge)",
        "anion_count": "lcm(abs(cation_charge), abs(anion_charge)) / abs(anion_charge)",
        "simplify_ratio": true
      },
      "formula_order": [
        "cation",
        "anion"
      ],
      "examples": [
        {
          "cation": "Na",
          "cation_charge": 1,
          "anion": "Cl",
          "anion_charge": -1,
          "result": "NaCl"
        },
        {
          "cation": "Mg",
          "cation_charge": 2,
          "anion": "Cl",
          "anion_charge": -1,
          "result": "MgCl2"
        },
        {
          "cation": "Al",
          "cation_charge": 3,
          "anion": "O",
          "anion_charge": -2,
          "result": "Al2O3"
        }
      ]
    },
    "polyatomic_ionic_compound_rule": {
      "id": "polyatomic_ionic_compound",
      "description": "Combine monatomic or polyatomic ions while preserving reusable polyatomic templates.",
      "available_template_references": [
        "NH4+",
        "OH^-",
        "NO3^-",
        "SO4^2-",
        "CO3^2-",
        "PO4^3-"
      ],
      "use_parentheses_when_polyatomic_coefficient_above_one": true,
      "examples": [
        {
          "cation_template": "NH4+",
          "cation_count": 2,
          "anion_template": "SO4^2-",
          "anion_count": 1,
          "result": "(NH4)2SO4"
        },
        {
          "cation": "Ca",
          "cation_charge": 2,
          "anion_template": "OH^-",
          "anion_count": 2,
          "result": "Ca(OH)2"
        },
        {
          "cation": "Al",
          "cation_charge": 3,
          "anion_template": "PO4^3-",
          "anion_count": 1,
          "result": "AlPO4"
        }
      ]
    }
  },
  "renderer_rules": {
    "ionic_compound": {
      "draw_bonds_between_ions": false,
      "render_each_ion_separately": true,
      "render_ions_inside_brackets": true,
      "render_charge_outside_brackets": true,
      "charge_position": "top_right",
      "repeat_ions_using_coefficient": true,
      "preserve_polyatomic_group_structure": true,
      "show_cation_electrons": false,
      "show_anion_complete_octet": true,
      "show_electron_transfer_arrows": false,
      "show_formula_unit_only": true
    },
    "monatomic_cation": {
      "render_lone_pairs": false,
      "render_empty_valence_shell": true,
      "render_charge": true
    },
    "monatomic_anion": {
      "render_lone_pairs": true,
      "default_lone_pair_count": 4,
      "render_charge": true
    },
    "polyatomic_ion": {
      "use_template_reference": true,
      "render_internal_covalent_bonds": true,
      "render_formal_charges": true,
      "render_overall_charge": true
    },
    "layout": {
      "default": "horizontal",
      "cation_position": "left",
      "anion_position": "right",
      "minimum_ion_spacing": 2,
      "instance_spacing": 2.5,
      "maximum_ions_per_row": 5,
      "wrap_large_compounds": true,
      "center_compound": true
    }
  },
  "validation_rules": {
    "require_neutral_total_charge": true,
    "total_charge_formula": "sum(ion_charge * coefficient)",
    "allow_variable_oxidation_states": true,
    "require_oxidation_state_for_transition_metals": true,
    "do_not_draw_covalent_bond_between_separate_ions": true,
    "require_parentheses_for_repeated_polyatomic_ions": true
  }
}